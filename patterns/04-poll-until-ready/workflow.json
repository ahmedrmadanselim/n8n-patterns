{
  "name": "Pattern — Poll until ready",
  "nodes": [
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.example.com/jobs",
        "options": {}
      },
      "id": "start",
      "name": "Create Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { jobId: $json.id, attempt: 0, maxAttempts: 10 } }];"
      },
      "id": "init",
      "name": "Init Attempts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "amount": "={{ Math.min(2 ** $json.attempt, 30) }}",
        "unit": "seconds"
      },
      "id": "wait",
      "name": "Backoff Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.example.com/jobs/{{ $json.jobId }}",
        "options": {}
      },
      "id": "check",
      "name": "Check Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.status }}",
              "rightValue": "ready"
            }
          ]
        }
      },
      "id": "ready",
      "name": "Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {},
      "id": "done",
      "name": "Use Result",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "number",
                "operation": "lt"
              },
              "leftValue": "={{ $json.attempt }}",
              "rightValue": "={{ $json.maxAttempts }}"
            }
          ]
        }
      },
      "id": "more",
      "name": "Attempts Left?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...$json, attempt: $json.attempt + 1 } }];"
      },
      "id": "bump",
      "name": "Increment Attempt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        480
      ]
    },
    {
      "parameters": {},
      "id": "giveup",
      "name": "Give Up — Alert",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1320,
        480
      ]
    }
  ],
  "connections": {
    "Create Job": {
      "main": [
        [
          {
            "node": "Init Attempts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Init Attempts": {
      "main": [
        [
          {
            "node": "Backoff Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backoff Wait": {
      "main": [
        [
          {
            "node": "Check Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Status": {
      "main": [
        [
          {
            "node": "Ready?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ready?": {
      "main": [
        [
          {
            "node": "Use Result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Attempts Left?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Attempts Left?": {
      "main": [
        [
          {
            "node": "Increment Attempt",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Give Up — Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Increment Attempt": {
      "main": [
        [
          {
            "node": "Backoff Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}